# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://username:password@localhost:5432/fygs_dev"

# Test database (optional). Leave it commented out: pnpm test:integration starts a
# disposable embedded PostgreSQL. Set it only to reuse a server of your own (it must be
# local and its database name must contain "test"; its tables are overwritten).
# TEST_DATABASE_URL="postgresql://postgres:password@localhost:5433/fygs_test"

# ==========================================
# REDIS CONFIGURATION (Native Redis)
# ==========================================
# Redis connection string for caching and rate limiting
# Format: redis://username:password@host:port or redis://host:port
REDIS_URL="redis://localhost:6379"

# Rate limiting: number of reverse proxies in front of the app that append to
# X-Forwarded-For (Traefik/Coolify alone = 1). The client IP is the entry that
# many hops from the right; a wrong value lets clients pick their own bucket.
# If Redis is unreachable, limits fall back to an in-process counter (per instance).
TRUSTED_PROXY_HOPS=1

# Legacy Redis URL support (maintained for compatibility)
blog_stats_KV_REST_API_URL="redis://localhost:6379"

# ==========================================
# AUTHENTICATION CONFIGURATION
# ==========================================
# Better Auth configuration (v1.3.11)
BETTER_AUTH_SECRET="your-super-secret-key-minimum-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# ==========================================
# STRIPE PAYMENT CONFIGURATION (v18.5.0)
# ==========================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs for subscriptions
STRIPE_MONTHLY_PRICE_ID="price_monthly_subscription"
STRIPE_YEARLY_PRICE_ID="price_yearly_subscription"

# ==========================================
# EMAIL CONFIGURATION (Nodemailer v7.0.6)
# ==========================================
EMAIL_FROM="noreply@fygs.dev"
EMAIL_FROM_NAME="FYGS Learning Platform"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your_email@gmail.com"
EMAIL_SERVER_PASSWORD="your_app_password"

# ==========================================
# ADMIN & SECURITY
# ==========================================
# Admin API key for maintenance operations
ADMIN_API_KEY="replace-with-32+-random-characters"
# Bearer secret of /api/cron/* (32+ characters)
CRON_SECRET="replace-with-32+-random-characters"

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ==========================================
# ANALYTICS & MONITORING
# ==========================================
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS="G-XXXXXXXXXX"

# Microsoft Clarity Project ID
NEXT_PUBLIC_MICROSOFT_CLARITY="xxxxxxxxxx"

# Vercel Analytics (automatically configured in Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"

# ==========================================
# SEO & VERIFICATION
# ==========================================
# Site verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your_google_verification_code"
NEXT_PUBLIC_YANDEX_VERIFICATION="your_yandex_verification_code"
NEXT_PUBLIC_NORTON_VERIFICATION="your_norton_verification_code"

# ==========================================
# DEVELOPMENT & FEATURE FLAGS
# ==========================================
# Enable debug logging
DEBUG=false

# Maintenance mode
MAINTENANCE_MODE=false

# Feature flags
ENABLE_PREMIUM_FEATURES=true
ENABLE_COURSE_CERTIFICATES=true
ENABLE_ANALYTICS=true

# ==========================================
# ERROR MONITORING (optional, nothing is sent without a DSN)
# ==========================================
# Server side, and browser side (the NEXT_PUBLIC_ one is inlined at build time).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
# Defaults to the commit (GIT_COMMIT_SHA / VERCEL_GIT_COMMIT_SHA) when empty
SENTRY_RELEASE=""

# ==========================================
# AI LEARNING ASSISTANT
# ==========================================
# Without ANTHROPIC_API_KEY the assistant still works in "offline mode"
# (local static analysis, clearly labelled in the UI). The key is only ever
# read on the server (POST /api/ai/assistant) and is never sent to the browser.
ANTHROPIC_API_KEY=""
# Model used by the assistant (default: claude-sonnet-5-5)
AI_MODEL="claude-sonnet-5-5"
# API base URL (default: https://api.anthropic.com); override for a proxy or a test mock
ANTHROPIC_BASE_URL="https://api.anthropic.com"
# Cost guard rails (0 disables a cap; invalid values keep the default).
# When the global daily budget (UTC day) is spent the tutor answers in offline
# mode with a notice, and logs the error event "ai.assistant.budget_exhausted".
# Counters live in Redis (in-process fallback if Redis is down).
AI_DAILY_REQUEST_BUDGET=2000
AI_DAILY_OUTPUT_TOKEN_BUDGET=1500000
# Per rolling 24 h: signed-in account / anonymous IP (on top of the hourly limits)
AI_USER_DAILY_REQUESTS=150
AI_GUEST_DAILY_REQUESTS=20

# ==========================================
# DEPLOYMENT & CI/CD
# ==========================================
# Coolify deployment webhook (for CD)
COOLIFY_WEBHOOK_URL="https://your-coolify-instance.com/webhooks/deploy"

# Environment-specific settings
VERCEL_ENV="development"
VERCEL_URL="your-app.vercel.app"

# ==========================================
# ADDITIONAL CONFIGURATION
# ==========================================
# Timezone for date/time operations
TZ="UTC"

# Default language/locale
DEFAULT_LOCALE="en"

# Session configuration
SESSION_MAX_AGE=2592000

# Cache TTL (in seconds)
CACHE_TTL=3600

# ==========================================
# Security hardening (see docs/SECURITY-OPERATIONS.md)
# ==========================================

# Required in production, 32+ random characters each (the server refuses to start otherwise):
#   BETTER_AUTH_SECRET (openssl rand -base64 48), CRON_SECRET, ADMIN_API_KEY
# Required in production: BETTER_AUTH_URL and NEXT_PUBLIC_SITE_URL, both https URLs of the site

# Content-Security-Policy with per-request nonces on signed-in areas. 0 / false / off sends it as Report-Only again.
CSP_NONCE_ENFORCE=1
# Extra locale-less paths to leave out of the nonce policy in an emergency (comma separated)
# CSP_NONCE_EXCLUDE=

# Proof-of-work on sign-up, contact, reviews, community posts and guest AI requests: enforce | report | off
HUMAN_PROOF_MODE=enforce
# Extra disposable e-mail domains to refuse, and domains always accepted (comma separated)
# DISPOSABLE_EMAIL_EXTRA_DOMAINS=
# EMAIL_DOMAIN_ALLOWLIST=

# Image hosts allowed for next/image besides the built-in ones (comma separated hostnames); the storage host of
# S3_PUBLIC_URL / S3_IMAGES_PUBLIC_URL is added automatically. Must be set at BUILD time.
# IMAGE_REMOTE_HOSTS=

# Stripe: the mode the secret key must be in (live | test) and a second webhook secret during a rotation
# STRIPE_EXPECT_MODE=live
# STRIPE_WEBHOOK_SECRET_PREVIOUS=
# Promotion codes at checkout (a 100% code grants free access by design)
STRIPE_ALLOW_PROMOTION_CODES=false


# First administrator: promote an existing verified user (npm run admin:bootstrap), then unset
# ADMIN_BOOTSTRAP_EMAIL=
# db:seed / db:reset refuse a non-local database unless both are set (never in production)
# SEED_ALLOW_PROD=1
# SEED_CONFIRM_DATABASE=

# ==========================================
# FILE STORAGE (any S3-compatible service: Garage, SeaweedFS, Cloudflare R2, Backblaze B2, Scaleway, AWS S3)
# ==========================================
# Without these, uploads answer "storage not configured" and authors paste an address instead.
# S3_PUBLIC_URL and S3_IMAGES_PUBLIC_URL are also read at BUILD time (next/image hosts): mark them as build variables.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Private bucket: videos, downloadable resources, captions (served through 15-minute signed addresses)
S3_BUCKET="fygs-videos"
# Public base address of that bucket (bucket included, no trailing slash)
S3_PUBLIC_URL="http://localhost:9000/fygs-videos"
# Public images (covers, avatars). Default: the same bucket and address as above. Only the image folders are public.
# S3_IMAGES_BUCKET=
# S3_IMAGES_PUBLIC_URL=
# A key of its own for images (default: the key above)
# S3_IMAGES_ACCESS_KEY_ID=
# S3_IMAGES_SECRET_ACCESS_KEY=
# Apply the public-read policy of the image folders once (see docs/storage-hardening.md); not every provider supports it
# S3_IMAGES_PUBLIC_POLICY=1

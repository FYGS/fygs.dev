{
  "name": "fygs.dev",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "dev:ps": "powershell -ExecutionPolicy Bypass -File ./dev.ps1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "dotenv -e .env.test -- vitest --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "vitest run",
    "test:setup": "docker compose -f docker-compose.test.yml up -d --wait && dotenv -e .env.test -- prisma db push --force-reset",
    "test:teardown": "docker compose -f docker-compose.test.yml down -v",
    "test:full": "pnpm test:setup && pnpm test:integration && pnpm test:teardown",
    "generate:preview": "node scripts/generate-preview.js",
    "migrate:techmastry": "tsx scripts/migrate-techmastry-clean.ts",
    "db:push": "prisma db push",
    "db:push:test": "dotenv -e .env.test -- prisma db push",
    "db:push:prod": "dotenv -e .env.production -- prisma db push",
    "db:studio": "prisma studio",
    "db:studio:test": "dotenv -e .env.test -- prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "dotenv -e .env.test -- tsx prisma/seed.ts",
    "db:seed:prod": "dotenv -e .env.production -- tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset --force && pnpm db:seed:test",
    "db:reset:prod": "dotenv -e .env.production -- prisma migrate reset --force && pnpm db:seed:prod",
    "resize-screenshots": "node scripts/resize-screenshots.js"
  },

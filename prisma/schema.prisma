generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  token     String
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  emailVerified     Boolean          @default(false)
  image             String?
  role              Role             @default(STUDENT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  bio               String?          // Community profile bio
  githubUrl         String?          // Social links for community
  linkedinUrl       String?
  websiteUrl        String?
  communityPoints   Int              @default(0) // Gamification points
  communityLevel    Int              @default(1) // User level based on activity
  lastActiveAt      DateTime?        // Last community activity
  isBanned          Boolean          @default(false) // User ban status for moderation
  AnalyticsEvent    AnalyticsEvent[]
  certificates      Certificate[]
  instructedCourses Course[]         @relation("CourseInstructor")
  enrollments       Enrollment[]
  InvoiceAudit      InvoiceAudit[]
  payments          Payment[]
  progress          Progress[]
  quizResults       QuizResult[]
  quizAttempts      QuizAttempt[]
  reviewModerations ReviewModeration[] @relation("ReviewModerator")
  examResults       ExamResult[]
  reviews           Review[]
  reviewVotes       ReviewVote[]
  reviewReplies     ReviewReply[]
  reviewReports     ReviewReport[]
  subscriptions     Subscription?
  accounts          Account[]
  sessions          Session[]
  // Community Relations
  discussions       Discussion[]
  discussionReplies DiscussionReply[]
  discussionVotes   DiscussionVote[]
  userBadges        UserBadge[]
  notifications     Notification[]   @relation("NotificationRecipient")
  sentNotifications Notification[]   @relation("NotificationSender")
  followedTopics    TopicFollow[]
  bookmarks         DiscussionBookmark[]
  mentorRequests    MentorRequest[]  @relation("MentorRequestStudent")
  mentorOffers      MentorRequest[]  @relation("MentorRequestMentor")
  // User following relations
  following         UserFollow[]     @relation("UserFollowing")
  followers         UserFollow[]     @relation("UserFollowers")
  // Gamification
  streak            UserStreak?
  xpEvents          XpEvent[]
  lessonNotes       LessonNote[]

  @@map("user")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               SubscriptionStatus @default(INCOMPLETE)
  priceId              String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 SubscriptionPlan   @default(FREE)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  slug        String
  description String?
  content     String?
  videoUrl    String?
  duration    Int?
  order       Int
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  courseId    String
  moduleId    String?
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      Module?    @relation(fields: [moduleId], references: [id])
  progress    Progress[]
  notes       LessonNote[]

  @@unique([moduleId, order])
  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  watchTime   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  amount                Decimal
  currency              String        @default("eur")
  status                PaymentStatus @default(PENDING)
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now())
  courseId              String?
  kind                  PaymentKind   @default(COURSE)
  stripePaymentIntentId String?
  course                Course?       @relation(fields: [courseId], references: [id])
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, status])
  @@index([courseId])
}

model InvoiceAudit {
  id              String   @id @default(cuid())
  userId          String
  stripeInvoiceId String?
  type            String
  amount          Decimal?
  createdAt       DateTime @default(now())
  currency        String?  @default("eur")
  metadata        Json?
  paymentId       String?
  subscriptionId  String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([createdAt])
}

model Review {
  id            String       @id @default(cuid())
  userId        String
  courseId      String
  rating        Int
  comment       String?
  verified      Boolean      @default(false) // Whether user completed the course
  helpfulCount  Int          @default(0)     // Number of helpful votes
  reportCount   Int          @default(0)     // Number of reports
  status        ReviewStatus @default(APPROVED) // Moderation status
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes         ReviewVote[] // Helpful/unhelpful votes
  replies       ReviewReply[] // Instructor replies
  reports       ReviewReport[] // User reports
  moderations   ReviewModeration[] // Moderation decisions, newest last

  @@unique([userId, courseId])
}

model ReviewVote {
  id       String   @id @default(cuid())
  userId   String
  reviewId String
  helpful  Boolean  // true for helpful, false for unhelpful
  createdAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String   // Usually the instructor
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReviewReport {
  id        String     @id @default(cuid())
  reviewId  String
  userId    String     // User who reported
  reason    ReportReason
  details   String?
  status    ReportStatus @default(PENDING)
  createdAt DateTime   @default(now())
  review    Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

/// One moderation decision on a review: who changed its status, from what to what. The review keeps
/// only its current status; this is the trail (and what the moderation page counts).
model ReviewModeration {
  id          String       @id @default(cuid())
  reviewId    String
  moderatorId String?
  fromStatus  ReviewStatus
  toStatus    ReviewStatus
  note        String?
  createdAt   DateTime     @default(now())
  review      Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderator   User?        @relation("ReviewModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@index([createdAt])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  color   String      @default("#3B82F6")
  courses CourseTag[]
}

model CourseTag {
  courseId String
  tagId    String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  type       String
  source     String?
  createdAt  DateTime @default(now())
  properties Json?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId, type])
  @@index([createdAt])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  slug      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@unique([courseId, order])
  @@index([courseId, order])
}

model VisualSupport {
  id        String   @id @default(cuid())
  courseId  String
  moduleId  Int
  title     String
  content   Json
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation("CourseToVisualSupport", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, moduleId, order])
  @@index([courseId, moduleId])
  @@map("visual_support")
}

model Quiz {
  id        String         @id @default(cuid())
  courseId  String
  moduleId  Int
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    Course         @relation("CourseToQuiz", fields: [courseId], references: [id], onDelete: Cascade)
  results   QuizResult[]   @relation("QuizToQuizResult")
  attempts  QuizAttempt[]  @relation("QuizToQuizAttempt")
  questions QuizQuestion[] @relation("QuizToQuizQuestion")
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  question    String
  options     String[]
  correct     Int
  explanation String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quiz        Quiz     @relation("QuizToQuizQuestion", fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, order])
  @@map("quiz_question_result")
}

model QuizResult {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  total       Int
  percentage  Int
  completedAt DateTime @default(now())
  quiz        Quiz     @relation("QuizToQuizResult", fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId, quizId, completedAt])
}

/// One sitting of a quiz. The first answer given to a question is the one that counts (answers
/// are recorded when the feedback is shown), and a new sitting is limited by a cooldown and a daily cap.
model QuizAttempt {
  id          String              @id @default(cuid())
  userId      String
  quizId      String
  startedAt   DateTime            @default(now())
  submittedAt DateTime?
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz                @relation("QuizToQuizAttempt", fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAttemptAnswer[]

  @@index([userId, quizId, startedAt])
}

model QuizAttemptAnswer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption Int
  answeredAt     DateTime    @default(now())
  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model FinalExam {
  id           String       @id @default(cuid())
  courseId     String
  title        String
  description  String?
  passingScore Int          @default(70) // Percentage needed to pass
  timeLimit    Int?         // Time limit in minutes (optional)
  questions    Json         // Array of question objects
  published    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course       @relation("CourseToFinalExam", fields: [courseId], references: [id], onDelete: Cascade)
  results      ExamResult[] @relation("FinalExamToExamResult")

  @@unique([courseId]) // One final exam per course
  @@index([courseId, published])
}

model ExamResult {
  id          String    @id @default(cuid())
  userId      String
  examId      String
  score       Int
  total       Int
  percentage  Int
  passed      Boolean
  answers     Json      // User's answers for review
  completedAt DateTime  @default(now())
  exam        FinalExam @relation("FinalExamToExamResult", fields: [examId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId, examId, passed, completedAt])
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseCategory {
  JAVASCRIPT
  TYPESCRIPT
  FRONTEND
  BACKEND
  FULLSTACK
  CLOUD
  AI
  DEVOPS
  PRODUCTIVITY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentKind {
  COURSE
  SUBSCRIPTION
  REFUND
}

enum CourseAccessTier {
  FREE
  PREMIUM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FAKE
  OFFENSIVE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// Community Forum Models
model Topic {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String
  color       String        @default("#3B82F6")
  icon        String?       // Lucide icon name
  order       Int           @default(0)
  courseId    String?       // Optional: course-specific topic
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  discussions Discussion[]
  followers   TopicFollow[]

  @@index([slug])
  @@index([courseId])
}

model Discussion {
  id            String               @id @default(cuid())
  title         String
  slug          String
  content       String
  authorId      String
  topicId       String
  courseId      String?              // Optional: course-specific discussion
  isPinned      Boolean              @default(false)
  isLocked      Boolean              @default(false)
  isSolved      Boolean              @default(false)
  viewCount     Int                  @default(0)
  replyCount    Int                  @default(0)
  upvoteCount   Int                  @default(0)
  downvoteCount Int                  @default(0)
  lastActivityAt DateTime            @default(now())
  tags          String[]             // Array of tags
  status        DiscussionStatus     @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic         Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  course        Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  replies       DiscussionReply[]
  votes         DiscussionVote[]
  bookmarks     DiscussionBookmark[]

  @@unique([topicId, slug])
  @@index([topicId, lastActivityAt])
  @@index([courseId])
  @@index([authorId])
  @@index([status])
}

model DiscussionReply {
  id           String               @id @default(cuid())
  content      String
  authorId     String
  discussionId String
  parentId     String?              // For nested replies
  upvoteCount  Int                  @default(0)
  downvoteCount Int                 @default(0)
  isAccepted   Boolean              @default(false) // Best answer
  isModerator  Boolean              @default(false) // Moderator response
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion   Discussion           @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent       DiscussionReply?     @relation("ReplyToReply", fields: [parentId], references: [id])
  children     DiscussionReply[]    @relation("ReplyToReply")
  votes        DiscussionVote[]

  @@index([discussionId, createdAt])
  @@index([authorId])
}

model DiscussionVote {
  id         String           @id @default(cuid())
  userId     String
  discussionId String?
  replyId    String?
  voteType   VoteType
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion Discussion?      @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  reply      DiscussionReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@unique([userId, replyId])
}

model DiscussionBookmark {
  id           String     @id @default(cuid())
  userId       String
  discussionId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
}

model TopicFollow {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   // User who is following
  followingId String   // User being followed
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String      // Icon name
  color       String      @default("#3B82F6")
  points      Int         @default(0) // Points required to earn
  type        BadgeType
  condition   String      // JSON condition for earning
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Notification {
  id         String           @id @default(cuid())
  recipientId String
  senderId   String?
  type       NotificationType
  title      String
  message    String
  data       Json?            // Additional notification data
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  recipient  User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender     User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@index([createdAt])
}

model MentorRequest {
  id          String              @id @default(cuid())
  studentId   String
  mentorId    String
  courseId    String?
  message     String
  status      MentorRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  student     User                @relation("MentorRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor      User                @relation("MentorRequestMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  course      Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, mentorId, courseId])
  @@index([mentorId, status])
}

// Add community relation to Course
model Course {
  id                  String           @id @default(cuid())
  title               String
  slug                String           @unique
  description         String
  thumbnail           String?
  price               Decimal?
  category            CourseCategory
  level               CourseLevel
  published           Boolean          @default(false)
  featured            Boolean          @default(false)
  duration            Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now())
  accessTier          CourseAccessTier @default(FREE)
  previewEnabled      Boolean          @default(true)
  instructorId        String?
  publicEvaluation    String?
  publicPrerequisites String?
  publicResources     String?
  publicStructure     String?
  trailerUrl          String?          // Video trailer for marketing landing
  faq                 Json?            // FAQ entries as JSON array [{q, a}]
  Certificate         Certificate[]
  instructor          User?            @relation("CourseInstructor", fields: [instructorId], references: [id])
  tags                CourseTag[]
  enrollments         Enrollment[]
  lessons             Lesson[]
  modules             Module[]
  payments            Payment[]
  quizzes             Quiz[]           @relation("CourseToQuiz")
  finalExam           FinalExam?       @relation("CourseToFinalExam")
  reviews             Review[]
  visualSupports      VisualSupport[]  @relation("CourseToVisualSupport")
  // Community Relations
  topics              Topic[]
  discussions         Discussion[]
  mentorRequests      MentorRequest[]
}

// New Enums for Community
enum DiscussionStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  FLAGGED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum BadgeType {
  PARTICIPATION   // Activity-based badges
  ACHIEVEMENT     // Milestone badges
  SPECIAL         // Special event badges
  MODERATOR       // Staff badges
}

enum NotificationType {
  DISCUSSION_REPLY
  DISCUSSION_MENTION
  DISCUSSION_UPVOTE
  BADGE_EARNED
  MENTOR_REQUEST
  FOLLOW
  SYSTEM_ANNOUNCEMENT
}

enum MentorRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─── Gamification: Streaks & XP ───────────────────────────────────────────────

model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActivityAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model XpEvent {
  id        String      @id @default(cuid())
  userId    String
  amount    Int
  reason    XpReason
  metadata  Json?       // e.g. { lessonId, quizId, courseId }
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum XpReason {
  LESSON_COMPLETED
  QUIZ_PASSED
  COURSE_COMPLETED
  STREAK_BONUS
  FIRST_LESSON
  DAILY_LOGIN
}

// ─── Inline Notes ─────────────────────────────────────────────────────────────

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  timestamp Int?     // Video timestamp in seconds (for timestamped notes)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

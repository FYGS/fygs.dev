exports[`POST /api/stripe/webhook (pinned behaviour) > invoiceFailed 1`] = `
{
  "body": {
    "received": true,
  },
  "log": [
    [
      "pay.verifyWebhookSignature",
      "{"raw":1}",
      "sig_x",
    ],
    [
      "log.info",
      [
        "Processing Stripe webhook event",
        {
          "eventType": "webhook.event_received",
          "metadata": {
            "type": "invoice.payment_failed",
          },
          "resourceId": "evt_1",
          "resourceType": "stripe_event",
        },
      ],
    ],
    [
      "pay.getSubscription",
      "sub_1",
    ],
    [
      "subscription.updateMany",
      {
        "data": {
          "status": "PAST_DUE",
        },
        "where": {
          "stripeSubscriptionId": "sub_1",
          "userId": "u1",
        },
      },
    ],
    [
      "user.findUnique",
      {

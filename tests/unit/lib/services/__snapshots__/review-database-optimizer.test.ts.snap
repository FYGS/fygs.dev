exports[`ReviewDatabaseOptimizer (pinned behaviour) > recommendationsIndexNeeded 1`] = `
{
  "log": [
    [
      "$queryRaw",
      "SELECT COUNT(*) as count FROM "Review" r LEFT JOIN pg_stat_user_tables t ON t.relname = 'ReviewVote' WHERE t.n_tup_ins > 1000 AND t.seq_scan > t.idx_scan",
      [],
    ],
  ],
  "outcome": {
    "value": [
      {
        "description": "High sequential scan ratio detected on ReviewVote table",
        "priority": "high",
        "sql": "CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_review_vote_review_id ON "ReviewVote"("reviewId");",
        "title": "Add Index on ReviewVote.reviewId",
        "type": "index",
      },
      {
        "description": "Improve review search performance with GIN index",
        "priority": "medium",
        "sql": "CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_review_comment_search ON "Review" USING gin(to_tsvector('english', comment));",
        "title": "Add Full-Text Search Index",
        "type": "index",
      },
      {
        "description": "Cache frequently accessed review statistics to reduce database load",
        "priority": "high",
        "title": "Implement Review Statistics Caching",
        "type": "cache",
      },
      {
        "description": "Use single query with proper joins instead of N+1 queries",
        "priority": "medium",
        "title": "Optimize Instructor Dashboard Query",
        "type": "query",
      },
      {
        "description": "Schedule regular maintenance to keep statistics up to date",
        "priority": "low",
        "sql": "VACUUM ANALYZE "Review", "ReviewVote", "ReviewReply", "ReviewReport";",
        "title": "Regular VACUUM and ANALYZE",
        "type": "maintenance",
      },
    ],
  },
}
`;

